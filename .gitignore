# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# 数据库文件 —— 运行时产物，不该进版本库
# （历史原因 dev.db 曾被跟踪，用 git rm --cached 解除）
*.db
*.db-journal
# 改 schema 前的备份（dev.db.bak-20261016-071652）—— 末尾是时间戳，
# 上面那条 *.db 匹配不到
*.db.bak-*

# 测试产物（测试用独立的库与素材目录，绝不碰 dev.db / public/patterns）
/coverage
/test.db
/test.db-journal
/.test-public

# Playwright（ET）产物
/test-results
/playwright-report
/blob-report
/playwright/.cache
# ET 的隔离构建目录（见 next.config.ts 的 distDir）
/.next-e2e
