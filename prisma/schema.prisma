generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Pattern {
  id              Int         @id @default(autoincrement())
  name            String
  alternateName   String?     @map("alternate_name")
  /// 可空：粗粒度朝代（商周/唐/汉）可考；精细断代与地域不做，无法准确考证时留空，
  /// 不编造。留空时前端不显示该行。
  dynasty         String?
  /// 精确定年做不了，这两个字段目前全部为空，保留以备将来有可靠资料。
  periodStart     String?     @map("period_start")
  periodEnd       String?     @map("period_end")
  region          String?
  ethnicGroup     String?     @map("ethnic_group")
  category        String      // 题材分类：动物纹、植物纹、几何纹等
  medium          String?     // 载体工艺：青铜器、玉器、织锦等
  description     String?
  culturalMeaning String?     @map("cultural_meaning")
  source          String?     // 来源出处
  sourceUrl       String?     @map("source_url")
  status          String      @default("draft")  // draft | published | rejected
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  /// 层级：parentId 为空 = 顶层条目（出现在浏览页）；非空 = 某个顶层条目的「式样」。
  ///
  /// 刻意【不强制两层】—— 没有子项的顶层条目就是普通单形态纹样，行为与加此字段前一致。
  /// 「类别」不是存储的属性，而是由"有没有子项"决定的行为。
  ///
  /// onDelete: Restrict —— 有子项时拒绝删除父条目，不是级联。
  /// 注意 Restrict 防不住环（A→B→A），环校验必须在写入路径上做，见 admin/patterns 路由。
  parentId        Int?        @map("parent_id")
  parent          Pattern?    @relation("PatternHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Pattern[]   @relation("PatternHierarchy")

  variations Variation[]
  relationsA Relation[] @relation("pattern_a")
  relationsB Relation[] @relation("pattern_b")
  tags       PatternTag[]
  images     PatternImage[]

  @@map("patterns")
}

model PatternImage {
  id         Int      @id @default(autoincrement())
  patternId  Int      @map("pattern_id")
  url        String   // 文件路径如 "/patterns/饕餮纹.jpg"
  type       String   // "bitmap" | "vector"
  purpose    String?  // "thumbnail" | "detail" | "closeup"
  label      String?  // 如"正面照"、"局部特写"
  isPrimary  Boolean  @default(false)  // 是否作为缩略图/主图
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@map("pattern_images")
}

/// ⚠️ 休眠模型 —— 当前无任何 UI 使用。
///
/// 原设计意图是「同一纹饰在不同时代/地域的演变」，配套的演变时间线页面已删除
/// （无法为单个纹样做可靠断代，该功能建在编造的数据上）。
/// 纹样的多形态需求改由 Pattern 的自引用 parentId 承载。
///
/// 保留不删是为了避免破坏性操作：variation_images 表零行，variation 表 8 行空壳，
/// 留着成本为零。若将来能拿到可靠的断代资料，时间线可在此模型上重建。
model Variation {
  id          Int      @id @default(autoincrement())
  patternId   Int      @map("pattern_id")
  variantName String   @map("variant_name")
  dynasty     String
  region      String?
  description String?
  periodStart String?  @map("period_start")
  periodEnd   String?  @map("period_end")
  createdAt   DateTime @default(now()) @map("created_at")

  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  images  VariationImage[]

  @@map("variations")
}

model VariationImage {
  id           Int      @id @default(autoincrement())
  variationId  Int      @map("variation_id")
  url          String
  type         String   // "bitmap" | "vector"
  purpose      String?  // "thumbnail" | "detail"
  label        String?
  isPrimary    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  variation Variation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@map("variation_images")
}

model Relation {
  id           Int    @id @default(autoincrement())
  patternAId   Int    @map("pattern_a_id")
  patternBId   Int    @map("pattern_b_id")
  relationType String @map("relation_type") // evolves_to | contains | variant_of | influences | same_theme
  description  String?

  patternA Pattern @relation("pattern_a", fields: [patternAId], references: [id], onDelete: Cascade)
  patternB Pattern @relation("pattern_b", fields: [patternBId], references: [id], onDelete: Cascade)

  @@map("relations")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
  type String // dynasty | region | ethnic | medium | category

  patterns PatternTag[]

  @@map("tags")
}

model PatternTag {
  patternId Int @map("pattern_id")
  tagId     Int @map("tag_id")

  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([patternId, tagId])
  @@map("pattern_tags")
}

model Period {
  id          Int      @id @default(autoincrement())
  name        String   @unique // 商、西周、春秋、战国...
  periodStart Int?     @map("period_start") // 用于排序，如 -1600
  periodEnd   Int?     @map("period_end")
  description String?

  @@map("periods")
}
