# 走国内镜像 —— 拉官方源经常超时
registry=https://registry.npmmirror.com

# npm 10.8 的 arborist 在解析 `canvas@^3.0.0` 的 peer 依赖时会崩：
#   TypeError: Cannot read properties of null (reading 'edgesOut')
#   at #loadPeerSet (arborist/build-ideal-tree.js)
# 这是 vitest → jsdom → canvas 这条链带出来的 npm 自身 bug，与本项目代码无关。
# 本项目不使用 npm 的 peer 依赖机制，关掉自动解析即可绕过。
legacy-peer-deps=true
